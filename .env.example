# ============================================================
# StockSense — Environment Variables
# Copy this file to .env and fill in your values.
# Every key here is read by config.py — see that file for exact defaults.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://stocksense:stocksense@localhost:5432/stocksense
DATABASE_DSN=postgresql://stocksense:stocksense@localhost:5432/stocksense

# --- Macro layer: Ollama (local) OR Ollama Cloud ---
# Local (default): runs on your machine, no key. qwen2.5:3b fits a 4GB GPU
# comfortably; use qwen2.5:7b only with 8GB+ VRAM.
OLLAMA_URL=http://localhost:11434
SLM_MODEL=qwen2.5:3b
# Ollama Cloud: set a key + the cloud base URL + a hosted model (e.g. Nemotron 3 Ultra).
# Leave OLLAMA_API_KEY empty to stay on local Ollama.
OLLAMA_API_KEY=

# --- Pipeline tuning ---
PIPELINE_INTERVAL_MINUTES=30
MAX_TICKERS_PER_RUN=200
TOP_SIGNALS_FOR_CLAUDE=40
CONFIDENCE_THRESHOLD=0.55

# --- Paper trading account ---
# This is the internal PAPER-mode ledger's starting balance only — it has
# nothing to do with your real Upstox account/funds.
BUY_ONLY=true
CASH_AVAILABLE=100000
CASH_RESERVE=10000

# --- Synthesis layer: bring-your-own CLI (claude | codex | gemini) ---
# No API key needed — each CLI carries its own login. The live choice is picked in the
# first-run setup modal; these are just fallback defaults / model overrides.
CLAUDE_SYNTHESIS_ENABLED=true
LLM_SYNTH_BACKEND=claude
ANTHROPIC_API_KEY=
# Claude Code (Anthropic): install `npm i -g @anthropic-ai/claude-code`, then `claude` -> /login
CLAUDE_SONNET_MODEL=claude-sonnet-4-6
CLAUDE_OPUS_MODEL=claude-opus-4-8
# All Claude CLI calls run at this --effort level (low|medium|high|xhigh|max).
# Low keeps token cost down for a pipeline calling out dozens of times/day.
CLAUDE_CLI_EFFORT=low
# Codex (OpenAI): install `npm i -g @openai/codex`, then `codex login`. Empty = codex default model.
CODEX_FAST_MODEL=
CODEX_DEEP_MODEL=
# Gemini (Google): install `npm i -g @google/gemini-cli`, then `gemini` -> /auth
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_DEEP_MODEL=gemini-2.5-pro

# --- Kronos forecaster (ARCHIVED — dropped for a LightGBM ensemble + quantile
# regressors; see config.py KRONOS_ENABLED. Default off; kept for a possible
# future A/B against a properly fine-tuned Kronos in the walk-forward harness.)
KRONOS_ENABLED=false
KRONOS_FORECAST_STEPS=5
KRONOS_MIN_CANDLES=30
KRONOS_MODEL_SIZE=mini

# --- Upstox (live market data — primary feed as of Stage 1) ---
# Create an app at https://account.upstox.com/developer/apps
# Redirect URI must match exactly what you register there.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/upstox/callback
# Analytics Token (recommended): generated ONCE from the developer portal,
# no daily re-authorization needed. Powers Market Data + Realtime &
# Streaming APIs — set this and the live feed/candles never need the daily
# OAuth dance. Falls back to the daily token above if left empty.
UPSTOX_ANALYTICS_TOKEN=
# Access token is generated daily via the OAuth flow — not stored here long-term,
# see data/pipeline/upstox_client.py once Stage 1 lands.

# --- Upstox Sandbox (risk-free order rehearsal — separate token, separate section
# of the developer portal from the Analytics Token above) ---
# Needed for backend/routers/confirmations.py's approve() to actually place a
# sandbox order. Never touches live money regardless of this token's presence.
UPSTOX_SANDBOX_TOKEN=
# Opt-in: when true, intelligence/live_confirmation.py can queue fresh
# qualifying signals for human review (POST /api/confirmations/queue-fresh).
# Default off — nothing queues for you until you explicitly enable this.
# NOTE on sizing: this sandbox/human-approval path sizes trades from REAL
# funds fetched live from Upstox (GET /v2/user/get-funds-and-margin, see
# data/pipeline/upstox_orders.get_available_funds()) — NOT from
# CASH_AVAILABLE below. It requires UPSTOX_SANDBOX_TOKEN to be set; if the
# funds fetch fails for any reason, queueing is skipped for that run rather
# than falling back to a static/fake number. CASH_AVAILABLE only feeds the
# separate, self-contained PAPER-mode ledger (intelligence/auto_trader.py).
LIVE_CONFIRMATION_ENABLED=false
# Short-lived cache (seconds) for the fetched Upstox available-funds figure
# within a single queue_fresh_signals() batch — avoids refetching per
# candidate ticker in the same run. Kept short since this sizes real orders.
UPSTOX_FUNDS_CACHE_SECONDS=30
# TEMPORARY STOPGAP — see config.py's SANDBOX_VIRTUAL_CAPITAL docstring.
# Real Upstox funds currently can't be read (sandbox has no funds endpoint;
# the live funds endpoint needs a static IP, which isn't registered). Until
# that's fixed, trades in the confirmation queue size against THIS number
# instead of a real balance — every reasoning string and Telegram message
# built from it is labeled "[SANDBOX VIRTUAL CAPITAL]" so it's never
# mistaken for real money. Delete this setting once a static IP is set up
# and get_available_funds() starts returning real data.
SANDBOX_VIRTUAL_CAPITAL=100000
# Sanity guard on a single sandbox order's value (qty x price) — refuses to
# place (FAILED, not silently clamped) if exceeded. Catches sizing bugs even
# though sandbox money isn't real.
MAX_SANDBOX_ORDER_VALUE=50000
# A PENDING confirmation older than this is treated as stale: approve()
# refuses to place the order (flips to EXPIRED instead) since the quoted
# price may no longer be current, and a scheduler job auto-expires old rows.
CONFIRMATION_EXPIRY_MINUTES=120

# --- Telegram approve/reject bot (optional; see docs/DAILY_MACHINE_SETUP.md) ---
# Approve/reject each queued trade from your phone. Strictly per-trade — the
# bot has no auto-approve mode by design. Create a bot via @BotFather to get
# the token; TELEGRAM_CHAT_ID is your own chat's numeric id (message the bot,
# then check https://api.telegram.org/bot<token>/getUpdates). The bot ignores
# every chat except this one. Both empty = feature off (clean no-op).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Angel One (fallback live price feed, optional) ---
# Kept as a secondary/fallback provider behind intelligence/provider_config.py.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PIN=
ANGEL_ONE_TOTP_KEY=

# --- Groww (deprecated — fake-candle snapshot path removed in Stage 1) ---
# Uncomment only if you take out a Groww API subscription (Rs 499/mo) and want
# to re-enable it as an additional provider. Not required; Upstox covers this.
# GROWW_API_KEY=
# GROWW_API_SECRET=
# GROWW_TOTP_SECRET=

# --- Filesystem paths ---
DATA_DIR=./data
MODELS_DIR=./models
NSE_DATA_DIR=./data/nse_raw
