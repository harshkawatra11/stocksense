# ============================================================
# StockSense — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Database ---
# Full SQLAlchemy async connection URL (used by ORM)
DATABASE_URL=postgresql+asyncpg://stocksense:stocksense@localhost:5432/stocksense
# Plain DSN for asyncpg direct connections
DATABASE_DSN=postgresql://stocksense:stocksense@localhost:5432/stocksense

# --- Ollama (runs on host, not in Docker — needs GPU) ---
# Base URL for the local Ollama server
OLLAMA_URL=http://localhost:11434
# Small language model to use for fast local inference
SLM_MODEL=phi3:mini

# --- Pipeline tuning ---
# How often (minutes) the scheduler re-runs the signal pipeline
PIPELINE_INTERVAL_MINUTES=30
# Maximum number of tickers processed in a single pipeline run
MAX_TICKERS_PER_RUN=200
# How many top signals are sent to Claude for deep analysis
TOP_SIGNALS_FOR_CLAUDE=40
# Minimum ML confidence score to emit a signal (0–1)
CONFIDENCE_THRESHOLD=0.55

# --- Anthropic / Claude ---
# API key for Anthropic (required for Phase 1+ Claude analysis)
ANTHROPIC_API_KEY=sk-ant-...
# Claude model used for fast / cheaper analysis
CLAUDE_SONNET_MODEL=claude-sonnet-4-5
# Claude model used for deep / expensive analysis
CLAUDE_OPUS_MODEL=claude-opus-4-5

# --- Angel One (Phase 2 — live trading, optional) ---
# API key from your Angel One SmartAPI account
ANGEL_ONE_API_KEY=
# Client ID from Angel One
ANGEL_ONE_CLIENT_ID=

# --- Filesystem paths ---
# Root data directory (relative or absolute)
DATA_DIR=./data
# Root models directory
MODELS_DIR=./models
# Where raw NSE Bhavcopy downloads are stored
NSE_DATA_DIR=./data/nse_raw
