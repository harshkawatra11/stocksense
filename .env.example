# ============================================================
# StockSense — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://stocksense:stocksense@localhost:5432/stocksense
DATABASE_DSN=postgresql://stocksense:stocksense@localhost:5432/stocksense

# --- Ollama (runs on host, not in Docker — needs GPU) ---
OLLAMA_URL=http://localhost:11434
# Use qwen2.5:7b (recommended) or qwen2.5:3b if VRAM is tight
SLM_MODEL=qwen2.5:7b

# --- Pipeline tuning ---
PIPELINE_INTERVAL_MINUTES=30
MAX_TICKERS_PER_RUN=200
TOP_SIGNALS_FOR_CLAUDE=40
CONFIDENCE_THRESHOLD=0.55

# --- Anthropic / Claude ---
# Not needed — Claude calls go through the `claude` CLI (Claude Code subscription).
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_SONNET_MODEL=claude-sonnet-4-6
CLAUDE_OPUS_MODEL=claude-opus-4-8

# --- Angel One (Phase 2 — live price feed, optional) ---
ANGEL_ONE_API_KEY=your-api-key-here
ANGEL_ONE_CLIENT_ID=AXXXXXXX
ANGEL_ONE_PIN=0000
ANGEL_ONE_TOTP_KEY=YOUR_TOTP_BASE32_SECRET

# --- Filesystem paths ---
DATA_DIR=./data
MODELS_DIR=./models
NSE_DATA_DIR=./data/nse_raw
