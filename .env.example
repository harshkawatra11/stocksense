# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Angel One SmartAPI (read-only use: funds, holdings, quotes, candles)
STOCKSENSE_ANGEL_API_KEY=
STOCKSENSE_ANGEL_CLIENT_CODE=
STOCKSENSE_ANGEL_PASSWORD=
STOCKSENSE_ANGEL_TOTP_SECRET=

# Upstox. The Analytics Token is read-only and valid for one year; it is the one this project uses.
STOCKSENSE_UPSTOX_API_KEY=
STOCKSENSE_UPSTOX_API_SECRET=
STOCKSENSE_UPSTOX_ACCESS_TOKEN=
STOCKSENSE_UPSTOX_ANALYTICS_TOKEN=

# Optional Telegram notifications
STOCKSENSE_TELEGRAM_BOT_TOKEN=
STOCKSENSE_TELEGRAM_ALLOWED_CHAT_ID=
STOCKSENSE_TELEGRAM_ALLOWED_USER_ID=
