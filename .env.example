# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Upstox API credentials (developer.upstox.com -> your app)
STOCKSENSE_UPSTOX_API_KEY=
STOCKSENSE_UPSTOX_API_SECRET=

# Upstox access tokens expire daily (~3:30am IST) per Upstox's own policy.
# This is a manually-obtained token for now (via the OAuth login flow) —
# the nightly pipeline will eventually need to automate re-auth, but for
# initial data pulls a manually refreshed token is enough to get started.
STOCKSENSE_UPSTOX_ACCESS_TOKEN=
